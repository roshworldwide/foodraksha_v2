# ─────────────────────────────────────────────────────────────
# FoodRaksha — environment
# Copy to `.env` and fill in. Never commit `.env`.
# Values marked REQUIRED are validated at startup by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string used by Prisma (app + migrations).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/foodraksha_dev?schema=public"

# ── Auth ────────────────────────────────────────────────────
# REQUIRED. 32+ random bytes, base64. Keys the HMAC that turns a session
# token into its database id, so a leaked database cannot forge sessions.
# Generate: openssl rand -base64 48
# Rotating this value logs everyone out.
AUTH_SECRET=""

# Session lifetime in days. Sliding — renewed when past halfway.
SESSION_DURATION_DAYS="30"

# Failed logins allowed per mobile number (and per IP) inside the window
# before further attempts are refused.
LOGIN_RATE_LIMIT_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# ── Application ─────────────────────────────────────────────
# Absolute base URL. Used in emails, SMS links and signed-URL callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Object storage (S3-compatible — Cloudflare R2) ──────────
# Private buckets only. Files are served through signed URLs, max 15 min.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Customer uploads: Aadhaar, PAN, layout plans, water test reports.
S3_BUCKET_DOCUMENTS="foodraksha-documents"
# Blank government PDF templates and generated application PDFs.
S3_BUCKET_TEMPLATES="foodraksha-templates"
# Signed URL lifetime in seconds. Must stay at or below 900 (15 minutes).
S3_SIGNED_URL_TTL_SECONDS="900"

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="FoodRaksha <no-reply@foodraksha.in>"
# Where customer replies land.
EMAIL_REPLY_TO="support@foodraksha.in"

# ── SMS (MSG91) ─────────────────────────────────────────────
MSG91_AUTH_KEY=""
# 6-character DLT-registered sender id, e.g. FDRKSH.
MSG91_SENDER_ID=""
# DLT template ids registered with the operator.
MSG91_TEMPLATE_ID_CREDENTIALS=""
MSG91_TEMPLATE_ID_STATUS_UPDATE=""

# ─────────────────────────────────────────────────────────────
# FoodRaksha — environment
# Copy to `.env` and fill in. Never commit `.env`.
# Values marked REQUIRED are validated at startup by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# REQUIRED. The connection the RUNNING APP uses for every query.
# On Supabase this is the transaction pooler (port 6543) — serverless
# functions open many short-lived connections and would exhaust a direct
# Postgres otherwise. Append ?pgbouncer=true so Prisma disables prepared
# statements, which the transaction pooler does not support.
# Supabase: Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# REQUIRED IN PRODUCTION. The direct connection (port 5432), used ONLY by
# `prisma migrate deploy` and `prisma db seed`. Migrations need a real session
# — the transaction pooler cannot run DDL or take advisory locks — so Prisma
# routes them here via `directUrl` in prisma/schema.prisma.
# Locally one Postgres serves both: set this to the same value as DATABASE_URL.
# Supabase: Project Settings → Database → Connection string → Session
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────
# REQUIRED. 32+ random bytes, base64. Keys the HMAC that turns a session
# token into its database id, so a leaked database cannot forge sessions.
# Generate: openssl rand -base64 48
# Rotating this value logs everyone out.
AUTH_SECRET=""

# Session lifetime in days. Sliding — renewed when past halfway.
SESSION_DURATION_DAYS="30"

# Failed logins allowed per mobile number (and per IP) inside the window
# before further attempts are refused.
LOGIN_RATE_LIMIT_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# ── Application ─────────────────────────────────────────────
# Absolute base URL. Used in emails, SMS links and signed-URL callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Object storage (S3-compatible: Supabase Storage or Cloudflare R2) ──
# Private buckets only. Files are served through signed URLs, max 15 min.
# The code is provider-neutral: it uses S3_ENDPOINT with path-style addressing,
# so any S3-compatible service works by changing these values alone.
#
# Browser uploads use a presigned PUT (not POST form uploads). The bucket needs
# a CORS rule allowing PUT from your app origin:
#   [{ "AllowedOrigins": ["https://app.foodraksha.in"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"] }]
#
# SUPABASE STORAGE — Project Settings → Storage → S3 connection:
#   S3_ENDPOINT="https://PROJECT.supabase.co/storage/v1/s3"
#   S3_REGION must be your project's real region (e.g. "ap-south-1").
#   Supabase REJECTS the "auto" region that R2 accepts — set it explicitly.
#   Keys come from Storage → S3 access keys (not the anon/service JWT).
#   Create the bucket as PRIVATE.
#
# CLOUDFLARE R2 — S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   with S3_REGION="auto".
#
# For local development without either, run `npm run dev:storage` and point
# S3_ENDPOINT at http://127.0.0.1:4599 with any key values.
S3_ENDPOINT="https://PROJECT.supabase.co/storage/v1/s3"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Customer uploads: Aadhaar, PAN, layout plans, water test reports.
S3_BUCKET_DOCUMENTS="foodraksha-documents"
# Blank government PDF templates and generated application PDFs.
S3_BUCKET_TEMPLATES="foodraksha-templates"
# Signed URL lifetime in seconds. Must stay at or below 900 (15 minutes).
S3_SIGNED_URL_TTL_SECONDS="900"

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="FoodRaksha <no-reply@foodraksha.in>"
# Where customer replies land.
EMAIL_REPLY_TO="support@foodraksha.in"

# ── SMS (MSG91) ─────────────────────────────────────────────
MSG91_AUTH_KEY=""
# 6-character DLT-registered sender id, e.g. FDRKSH.
MSG91_SENDER_ID=""
# DLT template ids registered with the operator.
MSG91_TEMPLATE_ID_CREDENTIALS=""
MSG91_TEMPLATE_ID_STATUS_UPDATE=""

# ── Seeding ─────────────────────────────────────────────────
# `prisma db seed` ALWAYS creates reference data (business categories, form
# sections) and exactly one ADMIN user — that is safe to run in production and
# is idempotent, so re-running never duplicates anything.
#
# Demo customers, applications and leads are opt-in. Leave SEED_DEMO unset in
# production so no fake data ever lands in the client's live database.
# SEED_DEMO="true"
#
# The admin's initial password is printed ONCE by the seed. Set it explicitly
# to choose your own; otherwise a random one is generated and printed.
# SEED_ADMIN_PASSWORD=""

# ── Error tracking (optional) ───────────────────────────────
# The app logs structured errors and exposes a single seam for Sentry in
# src/lib/log.ts. To enable Sentry, add @sentry/nextjs and set:
# SENTRY_DSN=""
